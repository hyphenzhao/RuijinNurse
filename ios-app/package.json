  "description": "瑞金医院功能神外宣讲AI — iOS/iPad App (Capacitor hybrid)",
  "main": "src/index.html",
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-charset.js",
    "cap:init": "npx cap init '瑞金神外护理助手' com.ruijin.nurse",
